[Unit]
Description=Sony WH-1000XM3 Headless Bluetooth Daemon
PartOf=graphical-session.target
After=bluetooth.target graphical-session.target
# The socket is created by the service manager before the daemon starts, and
# outlives daemon restarts.
Requires=sony-xm3.socket
After=sony-xm3.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/sony-xm3-daemon
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
Also=sony-xm3.socket
